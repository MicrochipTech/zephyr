/* mec_assy6941 EVB
 *
 * Set VTR2 to +3.3V
 * J68 2x8 1-2
 *
 * I2C Port 0
 * ----------
 * JP15 3x6 Pin Mux
 * ----------------
 * JP15 7-8 GPIO004 as I2C00_SCL
 * JP15 4-5 GPIO003 as I2C00_SDA
 *
 * JP27 3x12 Pin Mux
 * -----------------
 * JP27 31-32 GPIO004 as I2C00_SCL
 * JP27 34-35 GPIO003 as I2C00_SDA
 *
 * JP70 2x17 Pull-Up Selects
 * -------------------------
 * JP70 19-20 ON enable 7.5K pull-up to VTR1
 * JP70 21-22 ON enable 7.5K pull-up to VTR1
 *
 * J12 1x6
 * ------------------------------
 *	pin 1 = I2C00_SCL/GPIO004
 *	pin 2 = GND
 *	pin 3 = I2C00_SDA/GPIO003
 *	pin 4 = GND
 *	pin 5 = VTR1
 *	pin 6 = GND
 *
 * ----------------
 * I2C Port 7
 * ----------------
 * JP14 3x6
 * --------
 * 7-8, 16-17
 *
 * JP76 2x17
 * ---------
 * 21-22 7.5K pull-up to VTR2
 * 23-24 7.5K pull-up to VTR2
 *
 * J22 1x6
 * ------------------------------
 *	pin 1 = I2C07_SCL/GPIO013
 *	pin 2 = GND
 *	pin 3 = I2C07_SDA/GPIO012
 *	pin 4 = GND
 *	pin 5 = VTR2
 *	pin 6 = GND
 *
 */

#include <zephyr/dt-bindings/gpio/microchip-xec-gpio.h>
#include <zephyr/dt-bindings/dma/mchp-xec-dmac.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/i2c/mchp-xec-i2c.h>

/* I2C Controller 0 - pulled into the V3-NL driver. Two DMA channels:
 * "host" for controller-mode transfers, "target" for target-mode
 * transfers when the application registers an I2C target. Both use the
 * same DMAC instance but different channels and different trigger
 * sources. Target slot is wired even though the sample is
 * controller-only today, so target-mode applications can layer on
 * without an overlay edit.
 */
&dmac {
	status = "okay";
};

&i2c_smb_0 {
	compatible = "microchip,xec-i2c-v3-nl";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	dmas = <&dmac 0 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB0_CTRL>,
	       <&dmac 1 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB0_TARG>;
	dma-names = "host", "target";
	/* Holds [wr-addr | wr-data... | rd-addr] for the TX phase, and on
	 * multi-read transfers also the RX scatter staging area, so the
	 * larger of (1 + sum(wr) + 1) and sum(rd) must fit. The FRAM test
	 * writes up to 254 data bytes + a 2-byte offset, i.e. 1 + 256 = 257
	 * TX bytes, so 256 is one short; 260 covers the whole test range with
	 * headroom. Bump it further for clients that need larger writes.
	 */
	bounce-buffer-size = <260>;
	/* Target-mode RX staging: largest write the external host will
	 * issue plus one byte (matched target address). The driver strips
	 * the address before invoking buf_write_received.
	 */
	target-buffer-size = <256>;
	/* Port routed at boot, before the first transfer. */
	default-port = <&i2c0_p0>;
};

&i2c_smb_1 {
	compatible = "microchip,xec-i2c-v3-nl";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	dmas = <&dmac 2 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB1_CTRL>,
	       <&dmac 3 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB1_TARG>;
	dma-names = "host", "target";
	/* Holds [wr-addr | wr-data... | rd-addr] for the TX phase, and on
	 * multi-read transfers also the RX scatter staging area, so the
	 * larger of (1 + sum(wr) + 1) and sum(rd) must fit. The FRAM test
	 * writes up to 254 data bytes + a 2-byte offset, i.e. 1 + 256 = 257
	 * TX bytes, so 256 is one short; 260 covers the whole test range with
	 * headroom. Bump it further for clients that need larger writes.
	 */
	bounce-buffer-size = <260>;
	/* Target-mode RX staging: largest write the external host will
	 * issue plus one byte (matched target address). The driver strips
	 * the address before invoking buf_write_received.
	 */
	target-buffer-size = <256>;
	/* Port routed at boot, before the first transfer. */
	default-port = <&i2c1_p7>;
};

&i2c_smb_4 {
	compatible = "microchip,xec-i2c-v3-nl";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	dmas = <&dmac 8 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB4_CTRL>,
	       <&dmac 9 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB4_TARG>;
	dma-names = "host", "target";
	/* Holds [wr-addr | wr-data... | rd-addr] for the TX phase, and on
	 * multi-read transfers also the RX scatter staging area, so the
	 * larger of (1 + sum(wr) + 1) and sum(rd) must fit. The FRAM test
	 * writes up to 254 data bytes + a 2-byte offset, i.e. 1 + 256 = 257
	 * TX bytes, so 256 is one short; 260 covers the whole test range with
	 * headroom. Bump it further for clients that need larger writes.
	 */
	bounce-buffer-size = <260>;
	/* Target-mode RX staging: largest write the external host will
	 * issue plus one byte (matched target address). The driver strips
	 * the address before invoking buf_write_received.
	 */
	target-buffer-size = <256>;
	/* Port routed at boot, before the first transfer. */
	default-port = <&i2c4_p3>;
	/* Mark this controller as a wakeup source in target mode */
	wakeup-source;
};

/* define sleep states for I2C pins */
&pinctrl {
	i2c00_sda_gpio003_lp: i2c00_sda_gpio003_lp {
		pinmux = <MCHP_XEC_PINMUX(0003, MCHP_AF1)>;
		low-power-enable;
	};
	i2c00_scl_gpio004_lp: i2c00_scl_gpio004_lp {
		pinmux = <MCHP_XEC_PINMUX(0004, MCHP_AF1)>;
		low-power-enable;
	};
	i2c03_sda_gpio007_lp: i2c03_sda_gpio007_lp {
		pinmux = <MCHP_XEC_PINMUX(0007, MCHP_AF1)>;
		low-power-enable;
	};
	i2c03_scl_gpio010_lp: i2c03_scl_gpio010_lp {
		pinmux = <MCHP_XEC_PINMUX(0010, MCHP_AF1)>;
		low-power-enable;
	};
	i2c07_sda_gpio012_lp: i2c07_sda_gpio012_lp {
		pinmux = <MCHP_XEC_PINMUX(0012, MCHP_AF1)>;
		low-power-enable;
	};
	i2c07_scl_gpio013_lp: i2c07_scl_gpio013_lp {
		pinmux = <MCHP_XEC_PINMUX(0013, MCHP_AF1)>;
		low-power-enable;
	};
};

/* Port 0 pins */
&i2c00_sda_gpio003 {
	drive-open-drain;
};

&i2c00_scl_gpio004 {
	drive-open-drain;
};

/* Port 3 pins */
&i2c03_sda_gpio007 {
	drive-open-drain;
};

&i2c03_scl_gpio010 {
	drive-open-drain;
};

/* Port 7 pins */
&i2c07_sda_gpio012 {
	drive-open-drain;
	drive-strength = <3>;
};

&i2c07_scl_gpio013 {
	drive-open-drain;
	drive-strength = <3>;
};

/ {
	aliases {
		i2c0 = &i2c_smb_0;
		i2c1 = &i2c_smb_1;
		i2c2 = &i2c_smb_4;
		i2cport0 = &i2c0_p0;
		i2cport3 = &i2c4_p3;
		i2cport7 = &i2c1_p7;
	};

	/* Configure GPIO060 as test PLL clock out.
	 * We scope this pin to observe if PLL is turned off in deep sleep (suspend).
	*/
	zephyr,user {
		pinctrl-0 = <&tst_clk_out_gpio060>;
		pinctrl-names = "default";
	};

	/* Port 0 (default port) on I2C Controller 0 */
	i2c0_p0: i2c-port0 {
		compatible = "microchip,xec-i2c-v3-nl-port";
		#address-cells = <1>;
		#size-cells = <0>;
		port = <0>;
		controller = <&i2c_smb_0>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		pinctrl-0 = <&i2c00_sda_gpio003 &i2c00_scl_gpio004>;
		pinctrl-1 = <&i2c00_sda_gpio003_lp &i2c00_scl_gpio004_lp>;
		pinctrl-names = "default", "sleep";
		status = "okay";

		pca9555_evb: pca9555@26 {
			compatible = "nxp,pca9555";
			reg = <0x26>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <16>;
			status = "okay";
		};

		ltc2489_evb: ltc2489@34 {
			reg = <0x34>;
			status = "okay";
		};
	};

	/* Port 7 on I2C controller 1 */
	i2c1_p7: i2c-port7 {
		compatible = "microchip,xec-i2c-v3-nl-port";
		#address-cells = <1>;
		#size-cells = <0>;
		port = <7>;
		controller = <&i2c_smb_1>;
		clock-frequency = <I2C_BITRATE_FAST>;
		pinctrl-0 = <&i2c07_sda_gpio012 &i2c07_scl_gpio013>;
		pinctrl-1 = <&i2c07_sda_gpio012_lp &i2c07_scl_gpio013_lp>;
		pinctrl-names = "default", "sleep";
		status = "okay";

		i2c_targ1: i2c_target@20 {
			reg = <0x20>;
			status = "okay";
		};

		i2c_targ2: i2c_target@21 {
			reg = <0x21>;
			status = "okay";
		};

		mb85rc256v_fram: mb85rc256v_fram@50 {
			reg = <0x50>;
			status = "okay";
		};
	};

	i2c4_p3: i2c-port3 {
		compatible = "microchip,xec-i2c-v3-nl-port";
		#address-cells = <1>;
		#size-cells = <0>;
		port = <3>;
		controller = <&i2c_smb_4>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		pinctrl-0 = <&i2c03_sda_gpio007 &i2c03_scl_gpio010>;
		pinctrl-1 = <&i2c03_sda_gpio007_lp &i2c03_scl_gpio010_lp>;
		pinctrl-names = "default", "sleep";
		status = "okay";

		i2c_targ3: i2c_target@40 {
			reg = <0x40>;
			status = "okay";
		};

		i2c_targ4: i2c_target@41 {
			reg = <0x41>;
			status = "okay";
		};
	};
};
