/* mec_assy6941 EVB - dual-controller async sample (network-layer / DMA driver)
 *
 * Two INDEPENDENT physical I2C buses, one per controller. No fly wires.
 *
 * Set VTR2 to +3.3V: J68 2x8 1-2
 *
 * Thread A: i2c_smb_0 -> port 0 -> PCA9555 @0x26 (100 kHz)
 * -------------------------------------------------------
 * JP15 7-8   GPIO004 as I2C00_SCL
 * JP15 4-5   GPIO003 as I2C00_SDA
 * JP70 19-20 ON  7.5K pull-up to VTR1
 * JP70 21-22 ON  7.5K pull-up to VTR1
 *
 * Thread B: i2c_smb_1 -> port 7 -> FRAM mb85rc256v @0x50 (400 kHz)
 * ---------------------------------------------------------------
 * JP14 7-8, 16-17
 * JP76 21-22 7.5K pull-up to VTR2
 * JP76 23-24 7.5K pull-up to VTR2
 */

#include <zephyr/dt-bindings/gpio/microchip-xec-gpio.h>
#include <zephyr/dt-bindings/dma/mchp-xec-dmac.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/i2c/mchp-xec-i2c.h>

&dmac {
	status = "okay";
};

/* I2C Controller 0 - V3-NL driver. "host" channel for controller-mode
 * transfers; "target" channel wired for symmetry (unused by this
 * controller-only sample) so target-mode apps can layer on without an
 * overlay edit.
 */
&i2c_smb_0 {
	compatible = "microchip,xec-i2c-v3-nl";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	dmas = <&dmac 0 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB0_CTRL>,
	       <&dmac 1 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB0_TARG>;
	dma-names = "host", "target";
	/* Holds [wr-addr | wr-data... | rd-addr] for the TX phase. The FRAM
	 * test writes up to 254 data bytes + a 2-byte offset (257 TX bytes),
	 * so 260 covers the whole test range with headroom.
	 */
	bounce-buffer-size = <260>;
	target-buffer-size = <256>;
};

/* I2C Controller 1 - V3-NL driver. Separate DMA channels (2/3) from
 * controller 0 so both controllers can run transfers concurrently.
 */
&i2c_smb_1 {
	compatible = "microchip,xec-i2c-v3-nl";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	dmas = <&dmac 2 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB1_CTRL>,
	       <&dmac 3 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB1_TARG>;
	dma-names = "host", "target";
	bounce-buffer-size = <260>;
	target-buffer-size = <256>;
};

/* Port 0 pins */
&i2c00_sda_gpio003 {
	drive-open-drain;
};

&i2c00_scl_gpio004 {
	drive-open-drain;
};

/* Port 7 pins */
&i2c07_sda_gpio012 {
	drive-open-drain;
	drive-strength = <3>;
};

&i2c07_scl_gpio013 {
	drive-open-drain;
	drive-strength = <3>;
};

/ {
	aliases {
		i2c0 = &i2c_smb_0;
		i2c1 = &i2c_smb_1;
	};

	/* Port 0 (default port) on I2C Controller 0 - Thread A */
	i2c0_p0: i2c-port0 {
		compatible = "microchip,xec-i2c-v3-nl-port";
		#address-cells = <1>;
		#size-cells = <0>;
		port = <MCHP_XEC_I2C_CTRL_PORT(0, 0)>;
		controller = <&i2c_smb_0>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		pinctrl-0 = <&i2c00_sda_gpio003 &i2c00_scl_gpio004>;
		pinctrl-names = "default";
		default-port;
		status = "okay";

		/* Placeholder node (no compatible): accessed via raw I2C. */
		pca9555_evb: pca9555@26 {
			reg = <0x26>;
			status = "okay";
		};
	};

	/* Port 7 (default port) on I2C Controller 1 - Thread B */
	i2c1_p7: i2c-port7 {
		compatible = "microchip,xec-i2c-v3-nl-port";
		#address-cells = <1>;
		#size-cells = <0>;
		port = <MCHP_XEC_I2C_CTRL_PORT(1, 7)>;
		controller = <&i2c_smb_1>;
		clock-frequency = <I2C_BITRATE_FAST>;
		pinctrl-0 = <&i2c07_sda_gpio012 &i2c07_scl_gpio013>;
		pinctrl-names = "default";
		default-port;
		status = "okay";

		mb85rc256v_fram: mb85rc256v_fram@50 {
			reg = <0x50>;
			#io-channels-cells = <1>;
		};
	};
};
