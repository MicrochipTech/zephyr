/* mec_assy6941 EVB with mec1753_qlj
 *
 * I2C Port 0: i2c00_sda_gpio003 i2c00_scl_gpio004
 * JP15 3x6 SPI & SPI0 Signal DeMux
 * ON 4-5, 7-8
 *
 * JP27 3x12 UART-2 Signal DeMux
 * ON 31-32, 34-35
 *
 * JP61 2x2 Connect I2C00_SCL/SDA to EXTERNAL_SCLK/SDATA lines -> PCA9555 and LTC2487
 * ON 1-2, 3-4
 *
 * JP70 2x17 pull-ups (if target device does not have pulls)
 * ON 19-20, 21-22 connects I2C00_SCL and I2C00_SDA to 7.5K pull-ups to VTR1
 *
 * I2C Port 3: i2c03_sda_gpio007 i2c03_scl_gpio010
 * JP11 3x6 PS2 Signal DeMux
 * ON 7-8, 10-11
 *
 * JP29 3x8 UART-3 Signal DeMux
 * ON 7-8, 16-17
 *
 * JP70 2x17 pull-ups (if target device does not have pulls)
 * 23-24 connect I2C03_SCL to 7.5K pull to VTR1
 * 25-26 connect I2C03_SCL to 7.5K pull to VTR1
 *
 * J15 header 1x6
 * 1 = I2C03_SCL
 * 2 = GND
 * 3 = I2C03_SDA
 * 4 = N/C
 * 5 = VTR1
 * 6 = GND
 */

#include <zephyr/dt-bindings/dma/mchp-xec-dmac.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
	zephyr,user {
		/* Bus fault injection for the error paths of the I2C-NL driver.
		 *
		 * Fly wire fault-inject-gpios to the SDA line of port 0, the same net as
		 * i2c00_sda_gpio003. The sample pulls it low part way through a long host
		 * transfer, which the controller reports as an arbitration loss or a bus
		 * error depending on where the pull lands against SCL.
		 *
		 * GPIO050 (bank 1 pin 8: octal pin number 050 is 40, bank 40 / 32, pin
		 * 40 % 32) is a placeholder. Check the EVB schematic that the pin is free
		 * and brought out to a header before wiring anything to it, and change
		 * the entry here if it is not. Open drain so the pin only ever sinks:
		 * driving a push-pull high onto SDA would fight the bus.
		 *
		 * Without the wire fitted the sample still builds and runs, and reports
		 * that no fault was seen.
		 */
		fault-inject-gpios = <MCHP_GPIO_DECODE_050 GPIO_OPEN_DRAIN>;

		/* SDA pad of the port the faulted transfers run on, the same pin
		 * pinctrl assigns to the controller as i2c00_sda_gpio003. Used only to
		 * arm a GPIO interrupt on it, so that CONFIG_APP_FAULT_SYNC_START can
		 * time the pull from the START condition. The pin keeps its I2C
		 * function: the sample never configures it as a GPIO.
		 */
		fault-sda-gpios = <MCHP_GPIO_DECODE_003 0>;

		/* 32-bit basic timer. timer0 to timer3 are 16 bit and at 48 MHz reach
		 * only 1.365 ms, shorter than the transfer the fault lands inside.
		 */
		fault-inject-timer = <&timer4>;
	};

	aliases {
		i2c-target-port = &i2c_p0;
		i2c-controller-port = &i2c_p3;
	};

	/* Port 0 on I2C controller 0: targets and controller transfers share it */
	i2c_p0: i2c-port0 {
		compatible = "microchip,xec-i2c-nl-port";
		#address-cells = <1>;
		#size-cells = <0>;
		port = <0>;
		controller = <&i2c_smb_0>;
		clock-frequency = <I2C_BITRATE_FAST_PLUS>; /* <I2C_BITRATE_STANDARD>; */
		pinctrl-0 = <&i2c00_sda_gpio003 &i2c00_scl_gpio004>;
		pinctrl-names = "default";
		status = "okay";

		pca9555_evb: pca9555@26 {
			reg = <0x26>;
			status = "okay";
		};
	};

	/* Port 3 on I2C controller 1: controller mode */
	i2c_p3: i2c-port3 {
		compatible = "microchip,xec-i2c-nl-port";
		#address-cells = <1>;
		#size-cells = <0>;
		port = <3>;
		controller = <&i2c_smb_1>;
		clock-frequency = <I2C_BITRATE_FAST_PLUS>; /* <I2C_BITRATE_STANDARD>; */
		pinctrl-0 = <&i2c03_sda_gpio007 &i2c03_scl_gpio010>;
		pinctrl-names = "default";
		status = "okay";

		fram_evb: fram@50 {
			reg = <0x50>;
			status = "okay";
		};
	};
};

&dmac {
	status = "okay";
};

&uart1 {
	compatible = "microchip,xec-uart";
	status = "okay";
};

&i2c_smb_0 {
	compatible = "microchip,xec-i2c-nl";
	status = "okay";
	dmas = <&dmac 0 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB0_CTRL>,
	       <&dmac 1 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB0_TARG>;
	dma-names = "host", "target";
	/* Largest external write (register pointer + 256 data bytes), the START
	 * address byte, and a RPT-START address byte.
	 */
	target-buffer-size = <11>;
	default-port = <&i2c_p0>;
};

&i2c00_sda_gpio003 {
	drive-open-drain;
	output-enable;
	output-high;
	drive-strength = <4>;
};

&i2c00_scl_gpio004 {
	drive-open-drain;
	output-enable;
	output-high;
	drive-strength = <4>;
};

&i2c_smb_1 {
	compatible = "microchip,xec-i2c-nl";
	status = "okay";
	dmas = <&dmac 2 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB1_CTRL>,
	       <&dmac 3 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB1_TARG>;
	dma-names = "host", "target";
	/* Largest external write (register pointer + 256 data bytes), the START
	 * address byte, and a RPT-START address byte.
	 */
	target-buffer-size = <259>;
	default-port = <&i2c_p3>;
};

&i2c03_sda_gpio007 {
	drive-open-drain;
	output-enable;
	output-high;
	drive-strength = <4>;
};

&i2c03_scl_gpio010 {
	drive-open-drain;
	output-enable;
	output-high;
	drive-strength = <4>;
};

/* 32-bit basic timer used to time the bus fault injection */
&timer4 {
	status = "okay";
};
