/* mec_assy6941 EVB - deep-sleep wake-on-I2C sample (I2Cv3-NL / DMA driver).
 *
 * Topology:
 *   SMB0 = controller on port 0 @ 100 kHz.
 *   SMB1 = target 0x40 on port 7 @ 100 kHz (plain, not wake-capable).
 *   SMB4 = target 0x38 on port 3 @ 100 kHz, WAKE-CAPABLE (wakeup-source).
 *
 * Set VTR2 to +3.3V, J68 2x8 1-2.
 *
 * I2C Port 0 (SMB0 controller)
 * ----------------------------
 * JP15 3x6 Pin Mux:   7-8 GPIO004 as I2C00_SCL, 4-5 GPIO003 as I2C00_SDA
 * JP27 3x12 Pin Mux:  31-32 GPIO004 as I2C00_SCL, 34-35 GPIO003 as I2C00_SDA
 * JP70 2x17 Pull-Ups: 19-20 ON, 21-22 ON (7.5K to VTR1)
 * J12 1x6: pin 1 = I2C00_SCL/GPIO004, pin 3 = I2C00_SDA/GPIO003, pin 5 = VTR1
 *
 * I2C Port 7 (SMB1 target 0x40)
 * -----------------------------
 * JP14 3x6:  7-8, 16-17
 * JP76 2x17: 21-22, 23-24 (7.5K to VTR2)
 * J22 1x6: pin 1 = I2C07_SCL/GPIO013, pin 3 = I2C07_SDA/GPIO012, pin 5 = VTR2
 *
 * Pre-sleep loopback self-test wiring (port 0 <-> port 7):
 *   Fly wire J22-1 to J12-1 (SCL) and J22-3 to J12-3 (SDA).
 *   SMB0 (port 0) drives the 0x40 target that SMB1 exposes on port 7.
 *
 * I2C Port 3 (SMB4 target 0x38, wake source)
 * ------------------------------------------
 * I2C03_SDA = GPIO007, I2C03_SCL = GPIO010.
 * Connect the EXTERNAL I2C controller here. After the SoC enters deep
 * sleep, a START + address 0x38 from that controller wakes it.
 *
 * JP11 3x6: PS2 Signal Demux
 * 7-8 jumper ON. Select I2C03_SCL for GPIO010
 * 10-11 jumper ON. Select I2C03_SDA for GPIO007
 *
 * JP29 3x8: UART-3 Signal Demux
 * 7-8 jumper ON. Select I2C03_SDA for GPIO007
 * 16-17 jumper ON. Select I2C03_SCL for GPIO010
 *
 * JP70 2x17: Pull-ups to VTR1(+3.3V)
 * 23-24 jumper ON. 7.5K pull-up on I2C03_SDA
 * 25-26 jumper ON. 7.5K pull-up on I2C03_SCL
 *
 * J15 1x6 header
 * 1 = I2C03_SCL
 * 2 = GND
 * 3 = I2C03_SDA
 * 4 = N/C
 * 5 = VTR1 (+3.3V)
 * 6 = GND
 *
 * Test pins
 * GPIO241
 * JP19 3x6 5-6
 * JP69 2x17 1-2 pull-up (100K) to VTR1
 *
 * GPIO255
 * JP24 3x16 7-8
 * JP74 2x17 29-30 pull-up (100K) to VTR1
 *
 * vci_in1_n_gpio162
 * J56 3-4 no jumper
 * J57 3-4 jumper switch S4 via schmidt trigger U19B
 * JP147 2x17 27-28 no jumper
 *
 * tst_clk_out_gpio060
 * CPU daughter card assy6949 J1 2x5 pin 1 = TST_CLK_OUT_HD, pin 3 = GND
 */

#include <zephyr/dt-bindings/gpio/microchip-xec-gpio.h>
#include <zephyr/dt-bindings/dma/mchp-xec-dmac.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/i2c/mchp-xec-i2c.h>
#include "mec175x_pins_low_power.dtsi"

/ {
	aliases {
		i2c0 = &i2c_smb_0;
		i2c1 = &i2c_smb_1;
		i2c4 = &i2c_smb_4;
	};

	/* Configure GPIO060 as test PLL clock out.
	 * We scope this pin to observe if PLL is turned off in deep sleep (suspend).
	*/
	zephyr,user {
		test-pm-gpios = <MCHP_GPIO_DECODE_241 0>, <MCHP_GPIO_DECODE_255 0>;
		pinctrl-0 = <&tst_clk_out_gpio060 &vci_in1_n_gpio162>;
		pinctrl-names = "default";
	};

	/* Port 0 on SMB0 - controller side of the loopback self-test. */
	i2c0_p0: i2c-port0 {
		compatible = "microchip,xec-i2c-v3-nl-port";
		#address-cells = <1>;
		#size-cells = <0>;
		port = <MCHP_XEC_I2C_CTRL_PORT(0, 0)>;
		controller = <&i2c_smb_0>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		pinctrl-0 = <&i2c00_sda_gpio003 &i2c00_scl_gpio004>;
		pinctrl-1 = <&i2c00_sda_gpio003_lp &i2c00_scl_gpio004_lp>;
		pinctrl-names = "default", "sleep";
		status = "okay";
	};

	/* Port 7 on SMB1 - plain target 0x40. */
	i2c1_p7: i2c-port7 {
		compatible = "microchip,xec-i2c-v3-nl-port";
		#address-cells = <1>;
		#size-cells = <0>;
		port = <MCHP_XEC_I2C_CTRL_PORT(1, 7)>;
		controller = <&i2c_smb_1>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		pinctrl-0 = <&i2c07_sda_gpio012 &i2c07_scl_gpio013>;
		pinctrl-1 = <&i2c07_sda_gpio012_lp &i2c07_scl_gpio013_lp>;
		pinctrl-names = "default", "sleep";
		status = "okay";

		i2c_targ_040: i2c_target@40 {
			reg = <0x40>;
			status = "okay";
		};
	};

	/* Port 3 on SMB4 - wake-capable target 0x38, driven by the external
	 * controller that wakes the SoC from deep sleep.
	 */
	i2c4_p3: i2c-port3 {
		compatible = "microchip,xec-i2c-v3-nl-port";
		#address-cells = <1>;
		#size-cells = <0>;
		port = <MCHP_XEC_I2C_CTRL_PORT(4, 3)>;
		controller = <&i2c_smb_4>;
		clock-frequency = <I2C_BITRATE_STANDARD>;
		pinctrl-0 = <&i2c03_sda_gpio007 &i2c03_scl_gpio010>;
		pinctrl-1 = <&i2c03_sda_gpio007_lp &i2c03_scl_gpio010_lp>;
		pinctrl-names = "default", "sleep";
		status = "okay";

		i2c_targ_038: i2c_target@38 {
			reg = <0x38>;
			status = "okay";
		};
	};
};

/* eSPI peripheral channel device */
&acpi_ec0 {
	status = "okay";
};

/* eSPI peripheral channel device */
&acpi_ec1 {
	status = "okay";
};

&adc0 {
	compatible = "microchip,xec-adc";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&adc04_gpio204 &adc05_gpio205
		     &adc06_gpio206 &adc07_gpio207>;
	pinctrl-1 = <&adc04_gpio204_lp &adc05_gpio205_lp
		     &adc06_gpio206_lp &adc07_gpio207_lp>;
	pinctrl-names = "default", "sleep";
	
	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
	};

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
	};

	channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
	};

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <0>;
		zephyr,resolution = <12>;
	};	
};

&bbled0 {
	compatible = "microchip,bbled";
	/* TODO compatible = "microchip,pwmbbled"; */
	pinctrl-0 = <&led0_gpio156>;
	pinctrl-1 = <&led0_gpio156_lp>;
	pinctrl-names = "default", "sleep";
	status = "okay";	
};

&bbram {
	status = "okay";
};

&dmac {
	status = "okay";
};

/* eSPI peripheral channel device */
&emi0 {
	status = "okay";
};

&espi0 { /* chip level compatible = "microchip,xec-espi-v2"; */
	status = "okay";
	pinctrl-0 = <&espi_reset_n_gpio061 &espi_alert_n_gpio063
		     &espi_clk_gpio065 &espi_cs_n_gpio066
		     &espi_io0_gpio070 &espi_io1_gpio071
		     &espi_io2_gpio072 &espi_io3_gpio073>;
	pinctrl-1 = <&espi_reset_n_gpio061_lp &espi_alert_n_gpio063_lp
		     &espi_clk_gpio065_lp &espi_cs_n_gpio066_lp
		     &espi_io0_gpio070_lp &espi_io1_gpio071_lp
		     &espi_io2_gpio072_lp &espi_io3_gpio073_lp>;
	pinctrl-names = "default", "sleep";
};

&gpspi1 {
	compatible = "microchip,xec-gpspi-v2-mspi-controller";
	status = "okay";
	dmas = <&dmac 14 DMA_MCHP_XEC_TRIG_SRC_GPSPI1_TX>,
	       <&dmac 15 DMA_MCHP_XEC_TRIG_SRC_GPSPI1_RX>;
	dma-names = "tx", "rx";
	pinctrl-0 = <&spi1_clk_gpio141 &spi1_sdo_gpio142
		     &spi1_sdi_gpio143 &spi1_cs_n_gpio144>;
	pinctrl-1 = <&spi1_clk_gpio141_lp &spi1_sdo_gpio142_lp
		     &spi1_sdi_gpio143_lp &spi1_cs_n_gpio144_lp>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <DT_FREQ_M(24)>;
	op-mode = "MSPI_OP_MODE_CONTROLLER";
	duplex = "MSPI_HALF_DUPLEX";
	
	/* 25Q128JVSM +3.3V
	 * This SPI flash implements single, dual, and quad reads.
	 * For page program it only implements single and quad.
	 * GP-SPI only supports single and dual. Therefore we must
	 * specify single mode here because the MSPI device YAML
	 * binding only has one mspi-io-mode property for all commands.
	 * At the application level we can instantiate separate struct mspi_dev_cfg
	 * for page program 0x02 (1-1-1) and for dual read 0x3B (1-1-2).
	 */
	gp1_spiflash: gpspi1-nor-flash@0 {
		compatible = "jedec,nor";
		reg = <0>;
		mspi-hardware-ce-num = <1>;
		mspi-max-frequency = <DT_FREQ_M(12)>;
		mspi-io-mode = "MSPI_IO_MODE_SINGLE";
		mspi-data-rate = "MSPI_DATA_RATE_SINGLE";
		mspi-endian = "MSPI_BIG_ENDIAN";
		read-command = <0x0b>;
		write-command = <0x02>;
		command-length = "INSTR_1_BYTE";
		address-length = "ADDR_3_BYTE";
		tx-dummy = <0>;
		rx-dummy = <8>;
		size = <DT_SIZE_M(128)>;
		jedec-id = [ef 70 18];
		sfdp-bfp = [00];
		status = "okay";
	};
};

/* SMB0: controller only -> one "host" DMA channel. */
&i2c_smb_0 {
	compatible = "microchip,xec-i2c-v3-nl";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	dmas = <&dmac 0 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB0_CTRL>;
	dma-names = "host";
	bounce-buffer-size = <64>;
	default-port = <&i2c0_p0>;
};

/* SMB1: target 0x40 -> needs "host" + "target" DMA channels. */
&i2c_smb_1 {
	compatible = "microchip,xec-i2c-v3-nl";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	dmas = <&dmac 1 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB1_CTRL>,
	       <&dmac 2 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB1_TARG>;
	dma-names = "host", "target";
	bounce-buffer-size = <64>;
	target-buffer-size = <64>;
	default-port = <&i2c1_p7>;
	wakeup-source;
};

/* SMB4: wake-capable target 0x38 -> "host" + "target" DMA channels, plus
 * wakeup-source so the driver arms START-detect wake on suspend.
 */
&i2c_smb_4 {
	compatible = "microchip,xec-i2c-v3-nl";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	dmas = <&dmac 3 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB4_CTRL>,
	       <&dmac 4 DMA_MCHP_XEC_TRIG_SRC_I2C_SMB4_TARG>;
	dma-names = "host", "target";
	bounce-buffer-size = <64>;
	target-buffer-size = <64>;
	default-port = <&i2c4_p3>;
	wakeup-source;
};

/* Port 0 pins */
&i2c00_sda_gpio003 {
	drive-open-drain;
};

&i2c00_scl_gpio004 {
	drive-open-drain;
};

/* Port 7 pins */
&i2c07_sda_gpio012 {
	drive-open-drain;
	drive-strength = <3>;
};

&i2c07_scl_gpio013 {
	drive-open-drain;
	drive-strength = <3>;
};

/* Port 3 pins */
&i2c03_sda_gpio007 {
	drive-open-drain;
	drive-strength = <3>;
};

&i2c03_scl_gpio010 {
	drive-open-drain;
	drive-strength = <3>;
};

/* eSPI peripheral channel device */
&kbc0 {
	status = "okay";
};

&ps2_0 {
	compatible = "microchip,xec-ps2";
	pinctrl-0 = <&ps2_clk0a_gpio114 &ps2_dat0a_gpio115>;
	pinctrl-1 = <&ps2_clk0a_gpio114_lp &ps2_dat0a_gpio115_lp>;
	pinctrl-names = "default", "sleep";
	status = "okay";	
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_gpio053>;
	pinctrl-1 = <&pwm0_gpio053_lp>;
	pinctrl-names = "default", "sleep";
};

&qspi0 {
	compatible = "microchip,xec-qmspi-controller";
	/* TODO SPI compatible = "microchip,xec-qmspi-ldma" */
	status = "okay";
	pinctrl-0 = <&qspi_shd_cs0_n_gpio055 &qspi_shd_cs1_n_gpio002
		     &qspi_shd_clk_gpio056
		     &qspi_shd_io0_gpio223 &qspi_shd_io1_gpio224
		     &qspi_shd_io2_gpio227 &qspi_shd_io3_gpio016>;
	pinctrl-1 = <&qspi_shd_io3_gpio016_lp &qspi_shd_io2_gpio227_lp
		     &qspi_shd_io1_gpio224_lp &qspi_shd_io0_gpio223_lp
		     &qspi_shd_clk_gpio056_lp &qspi_shd_cs0_n_gpio055_lp>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <DT_FREQ_M(96)>;
	op-mode = "MSPI_OP_MODE_CONTROLLER";
	duplex = "MSPI_HALF_DUPLEX";
	num-hw-ce = <1>; /* Shared SPI supports two HW chip enables. We are using one */
	
	/* Assembly-6791 SPI flash dongle conntected to EVB J18 2x10 with JP87 on 2-3 VTR1(3.3V)
	 * Dongle has four W25Q128JV 128 megabit 3.3 SPI flash chips
	 */
	spiflash0: qspi-nor-flash@0 {
		compatible = "jedec,nor";
		reg = <0>;
		mspi-hardware-ce-num = <0>;
		mspi-max-frequency = <DT_FREQ_M(24)>;
		mspi-io-mode = "MSPI_IO_MODE_QUAD_1_1_4";
		mspi-data-rate = "MSPI_DATA_RATE_SINGLE";
		mspi-endian = "MSPI_BIG_ENDIAN";
		read-command = <0x6b>;
		write-command = <0x32>;
		command-length = "INSTR_1_BYTE";
		address-length = "ADDR_3_BYTE";
		tx-dummy = <0>;
		rx-dummy = <8>;
		size = <DT_SIZE_M(128)>;
		page-size = <256>;
		jedec-id = [ef 40 18];
		sfdp-bfp = [00];
		status = "okay";
	};
};

&rtc0 {
	status = "okay";
};

&tach0 {
	status = "okay";
	pinctrl-0 = <&ict0_tach0_gpio050>;
	pinctrl-1 = <&ict0_tach0_gpio050_lp>;
	pinctrl-names = "default", "sleep";
	tach-edges = <2>;
};

&timer0 {
	status = "okay";	
};

&watchdog0 {
	compatible = "microchip,xec-watchdog";
	status = "okay";
};

