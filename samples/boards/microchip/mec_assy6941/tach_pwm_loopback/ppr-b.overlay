 *
 * Row B of the pulses-per-round Latin square. Combined with the tach-edges
 * values fixed in app.overlay this build covers (2, 2), (3, 1), (5, 4), (9, 3).
 * Apply with EXTRA_DTC_OVERLAY_FILE so that app.overlay still takes effect.
 */

&tach0 {
	pulses-per-round = <2>;
};

&tach1 {
	pulses-per-round = <1>;
};

&tach2 {
	pulses-per-round = <4>;
};

&tach3 {
	pulses-per-round = <3>;
};
