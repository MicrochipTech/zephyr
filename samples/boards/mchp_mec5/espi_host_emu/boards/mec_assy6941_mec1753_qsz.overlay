/* mec_assy6941 EVB with MEC1753Q-SZ daughter card
 * MEC1753 does not have an internal SPI flash.
 * Connect QSPI to external shared SPI flash pins using SHD_nCS1.
 */

#include "mec_common.dtsi"

&qspi0 {
	compatible = "microchip,xec-qmspi-ldma";
	status = "okay";
	clock-frequency = <4000000>;
	pinctrl-0 = < &qspi_shd_cs0_n_gpio055_lp
		      &qspi_shd_cs1_n_gpio002
		      &qspi_shd_clk_gpio056
		      &qspi_shd_io0_gpio223
		      &qspi_shd_io1_gpio224
		      &qspi_shd_io2_gpio227
		      &qspi_shd_io3_gpio016 >;
	pinctrl-names = "default";
};
