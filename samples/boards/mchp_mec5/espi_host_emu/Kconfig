config SAMPLE_ESPI_ENABLE_PACKET_CRC
	bool "Configure eSPI packet CRC checking"
	default n
	help
	  eSPI emulated host will enable CRC packet checking

config SAMPLE_USE_ESPI_ALERT_PIN
	bool "Configure eSPI to use separate ESPI_nALERT pin instead of in-band alert"
	default n
	help
	  Use ESPI_nALERT side band pin as the alert mechanism
	  instead of the in-band alert on ESPI_IO1 pin.

config SAMPLE_ESPI_TAF
	bool "Exercise eSPI Flash channel in TAF (Target Attached Flash) mode"
	default n
	help
	  eSPI emulated host requests Target Attached Flash sharing mode
	  and runs flash write/read/erase tests using PUT_FLASH_NP.
	  If disabled, the Flash channel is enabled in Controller Attached
	  Flash Sharing (CAFS) mode and no flash traffic is generated.

config SAMPLE_ESPI_P80_ALIAS
	bool "Exercise Target Port 80 alias"
	default y
	help
	  Write one byte to the Target Port 80 alias I/O address given by the
	  zephyr,user target-p80-alias-io property (default 90h). The Target
	  captures it in the Port 80 byte lane selected by its p80bd0_alias
	  host-io-addr-mask. Disable when the Target does not enable the alias.

config SAMPLE_ESPI_ACPI_EC4
	bool "Exercise Target ACPI_EC4"
	default y
	help
	  Write ACPI_EC4 at Host I/O 340h and at its Host memory mapping
	  0x10002000: data +0, command/status +4. Disable when the Target
	  does not map ACPI_EC4.

config SAMPLE_HOST_HANDSHAKE_GPIOS
	bool "Use Host_nREADY / TARGET_nREADY sideband handshake GPIOs"
	default y
	help
	  Drive Host_nREADY to the Target and wait for TARGET_nREADY from the
	  Target before de-asserting ESPI_nRESET. Disable on benches where
	  those wires are not fitted: the emulator then leaves both pins
	  unconfigured and relies on the fixed start-up delay instead, so the
	  Target must have its eSPI driver initialised within that delay.

config SAMPLE_HOST_DRIVES_VCC_PWRGD
	bool "Host emulator drives the Target VCC_PWRGD input"
	default y
	help
	  Configure the espi-gpios[3] pin as an output and drive the Target's
	  VCC_PWRGD high during bring-up. Disable when something else on the
	  bench owns the Target VCC_PWRGD pin (for example a VPGGL loopback
	  test); the pin is then left unconfigured (input) so it cannot fight
	  the other driver.

config SAMPLE_STOP_AFTER_PLTRST
	bool "Stop after de-asserting PLTRST#"
	default n
	help
	  End the sequence right after sending SUS_STAT# = 1 and PLTRST# = 1,
	  leaving the eSPI link up and ESPI_nRESET de-asserted, and skip the
	  peripheral-channel I/O and memory tests. Use this to hold the
	  Target out of PCI Reset for tests that run on the Target itself
	  (e.g. VPGGL S0ix detection, whose enable bit is reset by PLTRST#).

config SAMPLE_VPGGL_SHELL
	bool "hvpggl console commands to drive the Target VPGGL inputs"
	select SAMPLE_STOP_AFTER_PLTRST
	help
	  Drive the Target's VPGGL (glue logic) inputs VCC_PWRGD, PWRGD_S0IX
	  and SLP_S0# from the GPIOs in zephyr,user vpggl-gpios
	  (boards/vpggl_bench.overlay), and the PLTRST#/HOST_C10 virtual
	  wires over the emulated eSPI link, with `hvpggl` commands typed on
	  the console (polled UART reader, not the Zephyr shell). The scripted
	  sequence stops after PLTRST# is de-asserted; commands stay available.

source "Kconfig.zephyr"
