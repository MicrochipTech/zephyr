config SAMPLE_ESPI_ENABLE_PACKET_CRC
	bool "Configure eSPI packet CRC checking"
	default n
	help
	  eSPI emulated host will enable CRC packet checking

config SAMPLE_USE_ESPI_ALERT_PIN
	bool "Configure eSPI to use separate ESPI_nALERT pin instead of in-band alert"
	default n
	help
	  Use ESPI_nALERT side band pin as the alert mechanism
	  instead of the in-band alert on ESPI_IO1 pin.

config SAMPLE_ESPI_TAF
	bool "Exercise eSPI Flash channel in TAF (Target Attached Flash) mode"
	default n
	help
	  eSPI emulated host requests Target Attached Flash sharing mode
	  and runs flash write/read/erase tests using PUT_FLASH_NP.
	  If disabled, the Flash channel is enabled in Controller Attached
	  Flash Sharing (CAFS) mode and no flash traffic is generated.

config SAMPLE_ESPI_ACPI_EC4
	bool "Exercise Target ACPI_EC4"
	default y
	help
	  Write ACPI_EC4 at Host I/O 340h and at its Host memory mapping
	  0x10002000: data +0, command/status +4. Disable when the Target
	  does not map ACPI_EC4.

source "Kconfig.zephyr"
