/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};
};

&uart0 {
	compatible = "microchip,xec-uart";
	status = "okay";
	host-io = <0x3F8>;
	clock-frequency = <1843200>;
	current-speed = <115200>;
	girqs = <MCHP_XEC_ECIA_GIRQ_ENC(15, 0)>;
	pcr-scr = <MCHP_XEC_SCR_ENCODE(2, 1)>;
	pinctrl-0 = <&uart0_tx_gpio104 &uart0_rx_gpio105>;
	pinctrl-names = "default";
};

&uart1 {
	status = "disabled";
};

/* i3c0 is not used in the standalone target application */
&i3c0 {
	status = "disabled";
};

/* i3c1: dual-role instance booted as I3C target */
&i3c1 {
	pinctrl-0 = <&i3c00_target_sda_gpio132 &i3c00_target_scl_gpio140>;
	pinctrl-names = "default";
	port-sel = <0>;
	/* Device role [7:6] = target: boot as target, never as a second controller */
	bcr = <0x06>;
	status = "okay";
};
