/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};
};

&uart0 {
	compatible = "microchip,xec-uart";
	status = "okay";
	host-io = <0x3F8>;
	clock-frequency = <1843200>;
	current-speed = <115200>;
	girqs = <MCHP_XEC_ECIA_GIRQ_ENC(15, 0)>;
	pcr-scr = <MCHP_XEC_SCR_ENCODE(2, 1)>;
	pinctrl-0 = <&uart0_tx_gpio104 &uart0_rx_gpio105>;
	pinctrl-names = "default";
};

&uart1 {
	status = "disabled";
};

/* i3c0: primary controller (host thread) */
&i3c0 {
	pinctrl-0 = <&i3c01_host_sda_gpio012 &i3c01_host_scl_gpio013>;
	pinctrl-names = "default";
	port-sel = <1>;
	i3c-scl-hz = <DT_FREQ_K(12500)>;
	od-thigh-min-ns = <500>;
	od-tlow-min-ns = <500>;
	primary-controller-da = <0x10>;
	status = "okay";

	/*
	 * Represents i3c1 on the bus as seen by the i3c0 host.
	 * The PID and static address match the tgt-pid and static-address
	 * of &i3c1, programmed when i3c1 is initialized, so SETDASA succeeds
	 * during the i3c0 bus initialization. They also match TGT_PID /
	 * TGT_STATIC_ADDR in target/src/target.c.
	 */
	i3c0_dev0: dev0@B0123456789A {
		compatible = "microchip,i3c-fake-target";
		reg = <0x08 0xB012 0x3456789A>;
		assigned-address = <0x08>;
		status = "okay";
	};
};

/* i3c1: dual-role instance booted as I3C target (target thread) */
&i3c1 {
	pinctrl-0 = <&i3c00_target_sda_gpio132 &i3c00_target_scl_gpio140>;
	pinctrl-names = "default";
	port-sel = <0>;
	/* Device role [7:6] = target: boot as target, never as a second controller */
	bcr = <0x06>;
	/* Target identity set at init, before the i3c0 bus initialization */
	static-address = <0x08>;
	tgt-pid = <0xB012 0x3456789A>;
	maximum-read = <128>;
	maximum-write = <128>;
	status = "okay";
};
