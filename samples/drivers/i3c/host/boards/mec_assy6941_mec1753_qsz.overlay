/ {
	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};
};

&uart0 {
	compatible = "microchip,xec-uart";
	status = "okay";
	host-io = <0x3F8>;
	clock-frequency = <1843200>;
	current-speed = <115200>;
	girqs = <MCHP_XEC_ECIA_GIRQ_ENC(15, 0)>;
	pcr-scr = <MCHP_XEC_SCR_ENCODE(2, 1)>;
	pinctrl-0 = <&uart0_tx_gpio104 &uart0_rx_gpio105>;
	pinctrl-names = "default";
};

&uart1 {
	status = "disabled";
};

/* i3c0: primary controller driving the Prodigy I3C exerciser as target */
&i3c0 {
	pinctrl-0 = <&i3c01_host_sda_gpio012 &i3c01_host_scl_gpio013>;
	pinctrl-names = "default";
	port-sel = <1>;
	i3c-scl-hz = <DT_FREQ_K(12500)>;
	od-thigh-min-ns = <500>;
	od-tlow-min-ns = <500>;
	primary-controller-da = <0x10>;
	status = "okay";

	/*
	 * Prodigy exerciser as target: PID 0x055800000000, enrolled by ENTDAA.
	 * reg = <static_addr pid_hi pid_lo>; static address 0 selects ENTDAA
	 * instead of SETDASA, although the exerciser has static address 0x55.
	 */
	prodigy: prodigy@55800000000 {
		compatible = "microchip,i3c-fake-target";
		zephyr,deferred-init;
		reg = <0x00 0x0558 0x00000000>;
	};
};

/* i3c1 is not used in the standalone host application */
&i3c1 {
	status = "disabled";
};
